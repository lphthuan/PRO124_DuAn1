--- !u!114 &1930463071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1930463067}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 73ce9ab454bb04047927aceeabb12872, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1516795300}
  npcText: {fileID: 484875778}
  dialogueText: {fileID: 1700538456}
  nameText: {fileID: 1762772842}
  dialogueLines:
  - "H\xE3y nh\xECn k\u1EF9 nh\u1EEFng bi\u1EC3u t\u01B0\u1EE3ng c\u1ED5 \u0111\u1EA1i
    n\xE0y... ch\xFAng l\xE0 ch\xECa kh\xF3a d\u1EABn \u0111\u01B0\u1EDDng."
  - "Tr\xED nh\u1EDB c\u1EE7a ng\u01B0\u01A1i c\xF3 th\u1EADt s\u1EF1 s\u1EAFc b\xE9n
    nh\u01B0 l\u1EDDi \u0111\u1ED3n? Nh\u1EDB k\u1EF9 chu\u1ED7i sau \u0111\xE2y!"
  - "Ta s\u1EBD ch\u1EC9 cho ng\u01B0\u01A1i m\u1ED9t chu\u1ED7i h\xECnh \u1EA3nh.
    N\u1EBFu ng\u01B0\u01A1i ghi nh\u1EDB \u0111\xFAng, c\xE1nh c\u1ED5ng s\u1EBD
    m\u1EDF."
  - "\u0110\u1EEBng \u0111\u1EC3 b\u1ECB \u0111\xE1nh l\u1EEBa b\u1EDFi s\u1EF1 \u0111\u01A1n
    gi\u1EA3n... th\u1EED th\xE1ch n\xE0y kh\xF4ng d\xE0nh cho k\u1EBB \u0111\xE3ng
    tr\xED."
  - "Khi gi\xF3 th\u1ED5i qua c\xE1c tr\u1EE5, h\xE3y xoay bi\u1EC3u t\u01B0\u1EE3ng
    \u0111\xFAng nh\u01B0 chu\u1ED7i \u0111\xE3 th\u1EA5y. Ch\u1EC9 th\u1EBF, ng\u01B0\u01A1i
    m\u1EDBi ti\u1EBFn xa h\u01A1n."
  - "Tr\xED nh\u1EDB ng\u01B0\u01A1i \u0111\xE3 s\u1EB5n s\xE0ng \u0111\u1ED1i m\u1EB7t
    v\u1EDBi th\u1EED th\xE1ch c\u1EE7a th\u1EDDi gian ch\u01B0a?"
  typingSpeed: 0.0001
  choicePanel: {fileID: 1637601811}
  Play: {fileID: 333934641}
  Exit: {fileID: 1217925957}
  PanelEmoji: {fileID: 1484317328}
  memoryManager: {fileID: 1441131214}
