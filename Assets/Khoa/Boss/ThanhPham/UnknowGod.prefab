--- !u!114 &235913127385450747
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8469524618216609680}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9febbe7d4293eff4b880e4af152d10f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 0}
  npcText: {fileID: 7863350344104733209}
  dialogueText: {fileID: 0}
  nameText: {fileID: 0}
  dialogueLines:
  - "Cu\u1ED1i c\xF9ng ng\u01B0\u01A1i c\u0169ng \u0111\xE3 t\u1EC9nh l\u1EA1i r\u1ED3i
    \xE0? Ng\u01B0\u01A1i \u0111\xE3 ng\u1EE7 kh\xE1 l\xE2u r\u1ED3i \u0111\u1EA5y!"
  - "Trong l\xFAc ng\u01B0\u01A1i ng\u1EE7, c\xE1c th\u1EBF l\u1EF1c \xE1c linh \u0111\xE3
    x\xE2m chi\u1EBFm th\u1EBF gi\u1EDBi th\u1EF1c t\u1EA1i n\xE0y. Ng\u01B0\u01A1i
    kh\xF4ng c\xF2n nhi\u1EC1u th\u1EDDi gian n\u1EEFa \u0111\xE2u"
  - "Ta kh\xF4ng th\u1EC3 tr\u1EF1c ti\u1EBFp can thi\u1EC7p, nh\u01B0ng ta s\u1EBD
    cho ng\u01B0\u01A1i bi\u1EBFt m\xECnh c\u1EA7n ph\u1EA3i l\xE0m g\xEC"
  - "H\xE3y m\u1EA1nh d\u1EA1ng, t\u1EF1 tin b\u01B0\u1EDBc ti\u1EBFp con \u0111\u01B0\u1EDDng
    ph\xEDa tr\u01B0\u1EDBc. \u0110\u1EEBng h\u1ECFi t\u1EA1i sao, c\u0169ng \u0111\u1EEBng
    quay \u0111\u1EA7u"
  - "V\xEC ch\u1EC9 khi ng\u01B0\u01A1i c\xF3 th\u1EC3 \u0111\xE1nh b\u1EA1i \u0111\u01B0\u1EE3c
    \u2B1C\u2B1C \u2B1C\u2B1C\u2B1C m\u1EDBi c\xF3 th\u1EC3 gi\u1EA3i c\u1EE9u \u0111\u01B0\u1EE3c
    th\u1EBF gi\u1EDBi n\xE0y "
  - "N\xE0o! \u0110\u1EEBng ch\u1EA7n ch\u1EEB n\u1EEFa, h\xE3y ti\u1EBFp t\u1EE5c
    ti\u1EBFn l\xEAn ph\xEDa tr\u01B0\u1EDBc \u0111i. Ta s\u1EBD g\u1EB7p l\u1EA1i
    nhau s\u1EDBm th\xF4i!"
  typingSpeed: 0.0001
