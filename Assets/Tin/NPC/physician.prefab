--- !u!114 &749162299200358406
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2146430053694852824}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83a907b3b3f4c51429d3e8a5fa2cd47b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 0}
  npcText: {fileID: 179999848428659549}
  dialogueText: {fileID: 0}
  nameText: {fileID: 0}
  dialogueLines:
  - "Kh\xED huy\u1EBFt ng\u01B0\u01A1i m\u1ECFng nh\u01B0 t\u01A1 nh\u1EC7n trong
    gi\xF3. M\u1ED9t khi b\u01B0\u1EDBc v\xE0o \u0111\u1EC1n c\u1ED5, ch\u1EC9 c\u1EA7n
    m\u1ED9t l\u1EDDi nguy\u1EC1n l\xE0 \u0111\u1EE7 x\xE9 x\xE1c ng\u01B0\u01A1i
    ra. Ta c\xF3 th\u1EC3 gia c\u1ED1 sinh m\u1EC7nh cho ng\u01B0\u01A1i\u2026 n\u1EBFu
    ng\u01B0\u01A1i ch\u1ECBu \u0111\u1EF1ng \u0111\u01B0\u1EE3c th\u1EE9 thu\u1ED1c
    n\xE0y."
  - "Th\u1EA7y ng\u01B0\u01A1i t\u1EEBng d\xF9ng b\xE0i thu\u1ED1c n\xE0y \u0111\u1EC3
    s\u1ED1ng s\xF3t qua ba ng\xE0y ba \u0111\xEAm b\u1ECB phong \u1EA5n trong huy\u1EBFt
    tr\u1EADn. N\u1EBFu ng\u01B0\u01A1i th\u1EADt s\u1EF1 l\xE0 ng\u01B0\u1EDDi k\u1EBF
    th\u1EEBa\u2026 th\xEC th\u1EC3 ch\u1EA5t ng\u01B0\u01A1i c\u0169ng ph\u1EA3i
    \u0111\u01B0\u1EE3c t\xF4i luy\u1EC7n nh\u01B0 \xF4ng \u1EA5y."
  - "Th\xE2n th\u1EC3 l\xE0 c\xE1i b\xECnh ch\u1EE9a linh h\u1ED3n. B\xECnh n\u1EE9t
    th\xEC ph\xE9p g\xEC c\u0169ng r\xF2 r\u1EC9. Ta c\xF3 th\u1EC3 h\xE0n l\u1EA1i
    b\xECnh \u1EA5y cho ng\u01B0\u01A1i \u2014 nh\u01B0ng ch\u1EC9 m\u1ED9t l\u1EA7n."
  - "Ta th\u1EA5y qu\u1EA7ng t\u1ED1i d\u01B0\u1EDBi m\u1EAFt ng\u01B0\u01A1i, tay
    ng\u01B0\u01A1i l\u1EA1nh nh\u01B0 x\xE1c ch\u1EBFt. Tr\u01B0\u1EDBc khi v\xE0o
    \u0111\u1EC1n, h\xE3y \u0111\u1EC3 ta k\xE9o sinh kh\xED ng\u01B0\u01A1i v\u1EC1\u2026
    k\u1EBBo \u0111i m\xE0 kh\xF4ng c\xF2n \u0111\u01B0\u1EDDng v\u1EC1."
  - "Lo\u1EA1i thu\u1ED1c n\xE0y kh\xF4ng c\u1EE9u ng\u01B0\u1EDDi\u2026 n\xF3 l\xE0m
    k\u1EBB y\u1EBFu tr\u1EDF n\xEAn l\xEC \u0111\xF2n h\u01A1n, s\u1ED1ng dai h\u01A1n,
    ch\u1ECBu \u0111\u1EF1ng \u0111\u01B0\u1EE3c nhi\u1EC1u h\u01A1n. Nh\u01B0ng
    \u0111\u1ED5i l\u1EA1i, ng\u01B0\u01A1i s\u1EBD kh\xF4ng bao gi\u1EDD th\u1EA5y
    d\u1EC5 th\u1EDF n\u1EEFa."
