--- !u!114 &367128951748504587
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2839454554200956696}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83a907b3b3f4c51429d3e8a5fa2cd47b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 0}
  npcText: {fileID: 3191184947308335356}
  dialogueText: {fileID: 0}
  nameText: {fileID: 0}
  dialogueLines:
  - "S\u1EAFt \u0111\xE1 th\xEC ai c\u0169ng r\xE8n \u0111\u01B0\u1EE3c... nh\u01B0ng
    th\u1EE9 ng\u01B0\u01A1i c\u1EA7n l\xE0 th\xE9p \u0111\xE3 t\xF4i b\u1EB1ng m\xE1u.
    N\u1EBFu ng\u01B0\u01A1i th\u1EF1c s\u1EF1 s\u1EB5n s\xE0ng, ta c\xF3 th\u1EC3
    l\xE0m th\u1EE9 \u0111\xF3\u2026 ch\u1EC9 m\u1ED9t l\u1EA7n."
  - "S\u01B0 ph\u1EE5 ng\u01B0\u01A1i t\u1EEBng \u0111\u1EC3 l\u1EA1i m\u1EA3nh l\u01B0\u1EE1i
    ki\u1EBFm g\xE3y \u1EDF \u0111\xE2y. Ta gi\u1EEF n\xF3 v\xEC ch\u01B0a t\u1EEBng
    g\u1EB7p ai \u0111\u1EE7 gan \u0111\u1EC3 ho\xE0n thi\u1EC7n n\xF3\u2026 cho
    \u0111\u1EBFn gi\u1EDD."
  - "Vong h\u1ED3n trong \u0111\u1EC1n c\u1ED5\u2026 \u0111\xE2u c\xF3 da th\u1ECBt
    \u0111\u1EC3 ch\xE9m? Ng\u01B0\u01A1i ngh\u0129 th\u1EBF. Nh\u01B0ng n\u1EBFu
    l\u01B0\u1EE1i r\xECu ta r\xE8n xuy\xEAn qua \u0111\u01B0\u1EE3c c\u1EA3 ph\xF9
    ch\xFA, ng\u01B0\u01A1i s\u1EBD ngh\u0129 kh\xE1c."
  - "Tay ng\u01B0\u01A1i run, \xE1nh m\u1EAFt c\xF2n l\u01B0\u1EE1ng l\u1EF1. Th\xE9p
    c\u1EE7a ta kh\xF4ng d\xE0nh cho k\u1EBB ch\u01B0a quy\u1EBFt t\xE2m. Khi n\xE0o
    tim ng\u01B0\u01A1i c\u1EE9ng nh\u01B0 b\xFAa ta\u2026 h\xE3y quay l\u1EA1i."
  - "Ta ch\u1EC9 \u0111\u1EADp m\u1ED9t nh\xE1t. N\u1EBFu ng\u01B0\u01A1i mu\u1ED1n
    truy\u1EC1n h\u1ED3n m\xECnh v\xE0o v\u0169 kh\xED\u2026 b\u01B0\u1EDBc t\u1EDBi.
    Sau \u0111\xF3, ho\u1EB7c l\xE0 ng\u01B0\u01A1i s\u1EBD m\u1EA1nh l\xEAn\u2026
    ho\u1EB7c v\u1EE1 tan."
  typingSpeed: 0.001
