--- !u!114 &3337447948988613617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6151691477033962098}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83a907b3b3f4c51429d3e8a5fa2cd47b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  parryCostText: {fileID: 0}
  shieldSoulTextGO: {fileID: 0}
  legacyUnlockSkillText: {fileID: 0}
  dialoguePanel: {fileID: 0}
  npcText: {fileID: 1759925750298902649}
  dialogueText: {fileID: 0}
  nameText: {fileID: 0}
  dialogueLines:
  - "Ng\u01B0\u01A1i c\xF2n qu\xE1 non tr\u1EBB \u0111\u1EC3 hi\u1EC3u r\u1EB1ng
    s\u1EE9c m\u1EA1nh lu\xF4n \u0111\xF2i h\u1ECFi c\xE1i gi\xE1 t\u01B0\u01A1ng
    x\u1EE9ng. H\xE3y nh\u1EDB, m\u1ED7i c\xE2u th\u1EA7n ch\xFA ng\u01B0\u01A1i
    ni\u1EC7m, \u0111\u1EC1u \u0111\u1EC3 l\u1EA1i m\u1ED9t v\u1EBFt n\u1EE9t trong
    linh h\u1ED3n."
  - "C\xF3 nh\u1EEFng ph\xE9p thu\u1EADt m\xE0 H\u1ED9i \u0110\u1ED3ng kh\xF4ng bao
    gi\u1EDD mu\u1ED1n ng\u01B0\u01A1i bi\u1EBFt. Ch\xFAng kh\xF4ng b\u1ECB c\u1EA5m
    v\xEC ch\xFAng nguy hi\u1EC3m\u2026 m\xE0 v\xEC ch\xFAng th\u1EADt s\u1EF1 hi\u1EC7u
    qu\u1EA3."
  - "Ng\u01B0\u01A1i tin v\xE0o \xE1nh s\xE1ng sao? H\xE3y th\u1EED g\u1ECDi t\xEAn
    n\xF3 khi \u0111\u1EE9ng m\u1ED9t m\xECnh gi\u1EEFa r\u1EEBng c\u1ED5 v\xE0o
    l\xFAc tr\u0103ng \u0111en... r\u1ED3i n\xF3i ta nghe, li\u1EC7u \xE1nh s\xE1ng
    c\xF3 \u0111\xE1p l\u1EA1i?"
  - "S\u01B0 ph\u1EE5 ng\u01B0\u01A1i t\u1EEBng \u0111\u1EB7t ch\xE2n v\xE0o \u0111\u1EC1n
    \u1EA5y\u2026 nh\u01B0ng kh\xF4ng tr\u1EDF ra. C\xF3 l\u1EBD th\u1EE9 \u0111ang
    tr\u1EA5n gi\u1EEF b\xEAn trong\u2026 \u0111\xE3 t\u1EEBng l\xE0 m\u1ED9t con
    ng\u01B0\u1EDDi."
  - "Sau nghi l\u1EC5, ng\u01B0\u01A1i s\u1EBD kh\xF4ng c\xF2n b\u01B0\u1EDBc nh\u01B0
    m\u1ED9t ng\u01B0\u1EDDi\u2026 m\xE0 nh\u01B0 b\xF3ng l\u01B0\u1EDBt gi\u1EEFa
    c\xF5i \xE2m. H\u1ECD s\u1EBD kh\xF4ng k\u1ECBp th\u1EA5y ng\u01B0\u01A1i \u0111\u1EBFn."
  typingSpeed: 0.001
  choicePanel: {fileID: 0}
